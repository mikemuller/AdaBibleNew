    <!-- ============ MEGA MENU ============ -->
    <!-- Extracted from src/components/MegaMenu/index.tsx. Content (nav
              groups, contact info, socials, locations) pulled live from
              adabible.org.
              The legacy CSS-Modules root class (`MegaMenu_megaMenu__QzrhR`)
              that used to sit alongside `.megaMenu` "for traceability" has
              been dropped: Styles/ada-styles/ada-megamenu.css — still loaded
              transitively via theme.css → ada-foundation.css →
              ada-megamenu.css — targets that exact class with
              `.MegaMenu_megaMenu__QzrhR:not(.MegaMenu_open) * { pointer-events:
              none !important; }`. Since this markup's JS toggles a plain
              `.open` class rather than `.MegaMenu_open`, that legacy selector
              always matched while the menu was open, silently killing every
              hover/click interaction (parent-link hover-to-reveal, subnav
              links, icon buttons — everything) inside it. The class served no
              functional purpose here (megamenu.scss/js both key off plain
              `.megaMenu`/`#megaMenu`), so it's removed rather than patched
              around. -->
    <div class="megaMenu" id="megaMenu" aria-hidden="true">
        <div class="shell">
            <div class="menuWrap">
                <div class="menuContent">

