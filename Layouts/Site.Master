<%@ Master Language="C#" AutoEventWireup="true" Inherits="Rock.Web.UI.RockMasterPage" %>

<%@ Import Namespace="System.Web.Optimization" %>
<!DOCTYPE html>

<script runat="server">

    // keep code below to call base class init method

    /// <summary>
    /// Raises the <see cref="E:System.Web.UI.Control.Init" /> event.
    /// </summary>
    /// <param name="e">An <see cref="T:System.EventArgs" /> object that contains the event data.</param>
    protected override void OnInit( EventArgs e )
    {
        base.OnInit( e );
    }

    protected void Page_Load( object sender, EventArgs e )
    {
        // declare vars
        var rockPage = this.Page as Rock.Web.UI.RockPage;
        string _pageDescription = String.Empty;
        string _backgroundImage = String.Empty;
        string _backgroundStyle = String.Empty;
        string _backgroundImagePrefix = String.Empty;
        string _currentPage = rockPage.PageId.ToString();

        if ( rockPage != null )
        {
            var pageCache = Rock.Web.Cache.PageCache.Get( rockPage.PageId );
            if ( pageCache != null )
            {
                _backgroundImage = pageCache.GetAttributeValue( "HeaderBackgroundImageURL" );
                if ( string.IsNullOrWhiteSpace( _backgroundImage ) )
                {
                    _backgroundImage = pageCache.GetAttributeValue( "HeaderBackgroundImage" );
                    _backgroundImagePrefix = "/GetImage.ashx?guid=";
                }
                _backgroundStyle = pageCache.GetAttributeValue( "HeaderBackgroundStyle" );

            }
        }
        if ( !string.IsNullOrWhiteSpace( _backgroundImage ) )
        {
            template_bgImage.Attributes.Add( "style", string.Format( "background-image:url('{0}{1}');{2}", _backgroundImagePrefix, _backgroundImage, _backgroundStyle ) );
        }
        else
        {
            template_bgImage.Attributes["class"] = "default-background header-background header-image-wrap";
        }

    }
</script>

