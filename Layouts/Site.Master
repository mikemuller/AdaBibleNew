                <div class="MediumImpact_heroShell MediumImpact_heroShellDark MediumImpact_heroShellWithMedia" style="background-color: var(--ada-color-main);">
                  <div class="MediumImpact_heroStrip" style="background-color: var(--ada-color-off-white);"></div>


                  <div class="MediumImpact_backgroundPattern" aria-hidden="true"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="MediumImpact_backgroundPatternImage" src="https://ada-bible.vercel.app/patterns/medium-impact-hero-background.svg" style="position: absolute; height: 100%; width: 100%; inset: 0px; color: transparent;"></div>
                  <div class="MediumImpact_dark MediumImpact_heroContent Gutter_gutter Gutter_narrow">
                    <div class="MediumImpact_mediumImpactHero">
                      <div class="MediumImpact_content">
